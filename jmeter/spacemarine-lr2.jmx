<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SpaceMarine ЛР2: одновременная работа пользователей">
      <stringProp name="TestPlan.comments">Группы потоков выполняются по очереди (Run Thread Groups consecutively). Итог — в группе «9. Проверка результатов».</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.desc">адрес приложения (через туннель — localhost)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
            <stringProp name="Argument.desc">порт (локальный конец SSH-туннеля)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CTX" elementType="Argument">
            <stringProp name="Argument.name">CTX</stringProp>
            <stringProp name="Argument.value">${__P(ctx,spacemarine)}</stringProp>
            <stringProp name="Argument.desc">контекст war</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ADMIN_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(adminPassword,admin)}</stringProp>
            <stringProp name="Argument.desc">пароль admin1/admin2 из schema.sql</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RUN" elementType="Argument">
            <stringProp name="Argument.name">RUN</stringProp>
            <stringProp name="Argument.value">${__time(MMddHHmmss,)}</stringProp>
            <stringProp name="Argument.desc">метка прогона: делает имена и координаты уникальными для каждого запуска</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
