        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Сгенерировать файл импорта (tg1)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">tg1</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// генерирует файл импорта и кладёт путь в IMPORT_FILE
// параметры: &lt;тип&gt; — tg1 (у каждого потока свой орден) | shared | twin
import groovy.json.JsonOutput
def kind = args[0]
def run = vars.get(&apos;RUN&apos;)
def base = Long.parseLong(run)
def t = ctx.getThreadNum() + 1
def it = vars.getIteration()
def dir = new File(System.getProperty(&apos;java.io.tmpdir&apos;), &apos;spacemarine-jmeter&apos;)
dir.mkdirs()
def records
if (kind == &apos;tg1&apos;) {
    def rnd = new Random()
    records = (1..2).collect { i -&gt;
        [name: &apos;JM imp &apos; + t + &apos;-&apos; + it + &apos;-&apos; + i,
         coordinates: [x: rnd.nextInt(2000) - 1000, y: rnd.nextInt(1600) - 800 + 0.25],
         chapter: [name: &apos;JM &apos; + run + &apos; user &apos; + t, marinesCount: 500],
         health: 50 + i, heartCount: 1, height: 180, meleeWeapon: &apos;CHAIN_AXE&apos;]
    }
} else {
    // одинаковое содержимое у всех потоков: shared — разные пользователи, twin — один пользователь
    def chapter = kind == &apos;shared&apos; ? &apos;JM import &apos; + run : &apos;JM twin &apos; + run
    def shift = kind == &apos;shared&apos; ? 0 : 10
    def y = kind == &apos;shared&apos; ? 2.5 : 3.5
    records = (1..3).collect { i -&gt;
        [name: &apos;JM &apos; + kind + &apos; marine &apos; + i,
         coordinates: [x: base + shift + i, y: y],
         chapter: [name: chapter, marinesCount: 300],
         health: 100, heartCount: 2, height: 190, meleeWeapon: &apos;POWER_SWORD&apos;]
    }
}
def f = new File(dir, kind + &apos;-&apos; + run + &apos;-t&apos; + t + &apos;-i&apos; + it + &apos;.json&apos;)
f.setText(JsonOutput.toJson(records), &apos;UTF-8&apos;)
vars.put(&apos;IMPORT_FILE&apos;, f.getAbsolutePath())</stringProp>
          </JSR223PreProcessor>
