          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// итог по кодам ответов, собранным группами 2–8
def codes = { k -&gt; (props.get(k) ?: []) }
def count = { k, c -&gt; codes(k).count { it == c } }
def lines = []
def errors = []

lines &lt;&lt; (&apos;2. Два обновления: &apos; + codes(&apos;TG2_CODES&apos;))
if (count(&apos;TG2_CODES&apos;, &apos;200&apos;) != 1) errors &lt;&lt; (&apos;2. Потерянное обновление: оба администратора получили 200 &apos;
        + codes(&apos;TG2_CODES&apos;) + &apos; — изменения одного перезаписаны другим без предупреждения&apos;)

lines &lt;&lt; (&apos;3. Изменение &apos; + codes(&apos;TG3_PUT_CODES&apos;) + &apos;, удаление &apos; + codes(&apos;TG3_DEL_CODES&apos;))
if (codes(&apos;TG3_PUT_CODES&apos;).any { it.startsWith(&apos;5&apos;) } || codes(&apos;TG3_DEL_CODES&apos;).any { it.startsWith(&apos;5&apos;) })
    errors &lt;&lt; &apos;3. Ошибка сервера 5xx при одновременном изменении и удалении&apos;

[[&apos;TG4_CODES&apos;, &apos;4. Гонка орденов&apos;], [&apos;TG5_CODES&apos;, &apos;5. Гонка координат&apos;],
 [&apos;TG6_CODES&apos;, &apos;6. Гонка импорта&apos;], [&apos;TG8_CODES&apos;, &apos;8. Гонка дубля&apos;]].each { p -&gt;
    def ok = count(p[0], &apos;201&apos;)
    lines &lt;&lt; (p[1] + &apos;: 201 × &apos; + ok + &apos;, все коды &apos; + codes(p[0]).countBy { it })
    if (ok != 1) errors &lt;&lt; (p[1] + &apos;: успешных ответов &apos; + ok + &apos;, ожидался ровно 1&apos;)
}
lines &lt;&lt; (&apos;7. Импорт из двух окон: коды &apos; + codes(&apos;TG7_CODES&apos;) + &apos;, добавлено &apos; + (props.get(&apos;TG7_ADDED&apos;) ?: []))
def added = (props.get(&apos;TG7_ADDED&apos;) ?: []).sum() ?: 0
if (added != 3) errors &lt;&lt; (&apos;7. Импорт из двух окон: всего добавлено &apos; + added + &apos;, ожидалось 3&apos;)

def text = lines.join(&apos;\n&apos;) + (errors ? &apos;\n\nНАРУШЕНИЯ:\n&apos; + errors.join(&apos;\n&apos;) : &apos;\n\nНарушений нет&apos;)
log.info(text)
SampleResult.setResponseData(text, &apos;UTF-8&apos;)
SampleResult.setDataType(&apos;text&apos;)
if (errors) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(errors.join(&apos; | &apos;))
}
return text</stringProp>
