          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Проверка уникальности орденов" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def run = vars.get(&apos;RUN&apos;)
def list = new JsonSlurper().parseText(prev.getResponseDataAsString())
def errors = []
def report = []
[[&apos;jm race &apos; + run, &apos;гонка орденов (группа 4)&apos;],
 [&apos;jm import &apos; + run, &apos;гонка импорта разных пользователей (группа 6)&apos;],
 [&apos;jm twin &apos; + run, &apos;импорт из двух окон (группа 7)&apos;]].each { pair -&gt;
    def n = list.count { it.name.toLowerCase() == pair[0] }
    report &lt;&lt; (pair[1] + &apos;: орденов «&apos; + pair[0] + &apos;» = &apos; + n)
    if (n != 1) errors &lt;&lt; (pair[1] + &apos;: создано орденов «&apos; + pair[0] + &apos;» — &apos; + n + &apos;, ожидался 1&apos;)
}
log.info(report.join(&apos;; &apos;))
if (errors) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(errors.join(&apos;; &apos;))
}</stringProp>
          </JSR223Assertion>
