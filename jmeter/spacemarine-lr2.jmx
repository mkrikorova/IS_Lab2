            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// запоминаем коды ответов группы в общих свойствах — их проверит итоговая группа
def key = args[0] + &apos;_CODES&apos;
synchronized (props) {
    def list = props.get(key) ?: []
    list = list + [prev.getResponseCode()]
    props.put(key, list)
}</stringProp>
