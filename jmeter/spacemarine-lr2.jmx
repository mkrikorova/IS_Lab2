        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Сохранить id и токены в свойства" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// значения из подготовки нужны другим группам потоков — переносим в свойства
[&apos;TARGET_A&apos;, &apos;TARGET_B&apos;, &apos;TWIN_TOKEN&apos;, &apos;TWIN_CH&apos;, &apos;SHARED_CH&apos;].each { k -&gt;
    def v = vars.get(k)
    if (v == null || v.startsWith(&apos;NOT_&apos;) || v.startsWith(&apos;NO_&apos;)) {
        SampleResult.setSuccessful(false)
        SampleResult.setResponseMessage(&apos;Подготовка не удалась: нет &apos; + k + &apos;. Проверьте адрес и что приложение запущено&apos;)
    }
    props.put(k, v)
}
[&apos;TG2_CODES&apos;, &apos;TG3_PUT_CODES&apos;, &apos;TG3_DEL_CODES&apos;, &apos;TG4_CODES&apos;, &apos;TG5_CODES&apos;, &apos;TG6_CODES&apos;, &apos;TG7_CODES&apos;, &apos;TG8_CODES&apos;].each { props.remove(it) }
props.remove(&apos;TG7_ADDED&apos;)
return &apos;TARGET_A=&apos; + vars.get(&apos;TARGET_A&apos;) + &apos;, TARGET_B=&apos; + vars.get(&apos;TARGET_B&apos;) + &apos;, TWIN_CH=&apos; + vars.get(&apos;TWIN_CH&apos;)</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="1. Работа N пользователей: создание, изменение, импорт, удаление" enabled="true">
        <stringProp name="TestPlan.comments">Обычная одновременная работа: покрывает создание, изменение, удаление и импорт. Все запросы должны быть успешными.</stringProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users,10)}</stringProp>
